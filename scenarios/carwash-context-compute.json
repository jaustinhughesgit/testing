{
  "name": "Carwash compute reads and updates ordinary ContextDB entities",
  "setup": [
    {
      "name": "store car ownership",
      "input": "I have a car",
      "execution": "published-semantic-path",
      "equationId": "activity_possession_composed_statement",
      "publishContext": true,
      "expect": {
        "kind": "statement",
        "execution": "published-semantic-path"
      }
    },
    {
      "name": "store car make and model",
      "input": "My car is a Toyota Camry",
      "execution": "published-semantic-path",
      "equationId": "owned_entity_alias_composed_statement",
      "expect": {
        "kind": "statement",
        "execution": "published-semantic-path"
      }
    },
    {
      "name": "store dirty car state",
      "input": "My Toyota Camry is dirty.",
      "execution": "published-semantic-path",
      "equationId": "self_property_composed_statement",
      "expect": {
        "kind": "statement",
        "execution": "published-semantic-path"
      }
    }
  ],
  "build": {
    "requirementSegments": [
      "Build me a carwash app that will clean my car.",
      "I can say, \"wash my car\", \"wash my camry\" or \"wash my toyota\".",
      "It will switch my car from dirty to clean.",
      "It will respond \"Your car is clean\", \"Your Camry is clean\" or \"Your Toyota is clean\".",
      "It will update the status from dirty to clean."
    ],
    "expectContextEffect": {
      "type": "contextdb.replace_object",
      "currentValue": "dirty"
    },
    "expectUtterances": ["wash my car", "wash my camry", "wash my toyota"],
    "expectAnnotatedUtterances": true,
    "expectUtteranceValues": {
      "wash my car": "car",
      "wash my camry": "camry",
      "wash my toyota": "toyota"
    }
  },
  "steps": [
    {
      "type": "invoke",
      "name": "wash Camry",
      "input": "Wash my Camry",
      "subjectValue": "Camry",
      "expect": {
        "answer": "Your Camry is clean",
        "mutationCount": 2
      }
    },
    {
      "type": "invoke",
      "name": "wash Toyota after it is clean",
      "input": "Wash my Toyota",
      "subjectValue": "Toyota",
      "expect": {
        "answer": "Your Toyota is clean",
        "mutationCount": 0
      }
    },
    {
      "type": "invoke",
      "name": "wash car after it is clean",
      "input": "Wash my car",
      "subjectValue": "car",
      "expect": {
        "answer": "Your car is clean",
        "mutationCount": 0
      }
    },
    {
      "type": "essence",
      "name": "read Camry status",
      "input": "What is the status of my Camry",
      "execution": "published-semantic-path",
      "equationId": "owned_entity_status_composed_query",
      "expect": {
        "kind": "question",
        "execution": "published-semantic-path",
        "answer": ["clean"]
      }
    },
    {
      "type": "essence",
      "name": "check Toyota condition",
      "input": "Is my Toyota clean or dirty?",
      "execution": "published-semantic-path",
      "equationId": "owned_entity_choice_composed_query",
      "expect": {
        "kind": "question",
        "execution": "published-semantic-path",
        "answer": ["clean"]
      }
    }
  ]
}
